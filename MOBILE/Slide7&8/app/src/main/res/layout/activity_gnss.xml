<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GnssActivity">

    <TextView
        android:id="@+id/textViewGNSS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Informacoes do Sistema de Satelites nao Disponiveis"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="1dp" />

    <Button
        android:id="@+id/buttonStartGNSS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="startGNSS"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonStopGNSS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="stopGNSS"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonStartGNSS" />
</androidx.constraintlayout.widget.ConstraintLayout>